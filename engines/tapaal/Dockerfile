# Tapaal's verifypn. Build from the repository root:
#   docker build -f engines/tapaal/Dockerfile -t pn-llm-verif/tapaal:4.4.2 .
# Licence: GPL-3.0-or-later (https://github.com/TAPAAL/verifypn). The image is built locally from
# source and not redistributed by this project; anyone who publishes it must offer the source.
# The tool's own CMake fetches its dependencies (ptrie by commit, rapidxml, spot 2.11.3, glpk) at
# build time, pinned by the tool's commit but without checksums: a limit we accept.
# Debian 12 (bookworm) on purpose: spot 2.11.3 ships files generated by automake 1.16, which
# Debian 13 no longer provides.

# ---- Stage 1: build verifypn from source, at a pinned commit ---------------------------------
FROM python:3.14-slim-bookworm AS build
ARG TOOL_COMMIT=0f4862d296918434c7cd75adf424d27fecd0bba6
# Debian package versions rotate with security fixes; the base image is what is pinned, by tag.
# hadolint ignore=DL3008
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential cmake flex bison git ca-certificates libgmp-dev automake autoconf libtool \
 && rm -rf /var/lib/apt/lists/*
RUN git init /src \
 && git -C /src remote add origin https://github.com/TAPAAL/verifypn.git \
 && git -C /src fetch --depth 1 origin "${TOOL_COMMIT}" \
 && git -C /src checkout --detach FETCH_HEAD \
 && git -C /src submodule update --init --recursive --depth 1
# The contest configuration: dynamic libraries, the simplifications the contest uses.
RUN cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release -DVERIFYPN_Static=OFF -DVERIFYPN_MC_Simplification=ON \
 && cmake --build /build --parallel "$(nproc)" \
 && mkdir -p /opt/tool && cp /build/verifypn/bin/verifypn-* /opt/tool/verifypn

# ---- Stage 2: the runtime image --------------------------------------------------------------
FROM python:3.14-slim-bookworm AS runtime
ARG TOOL_VERSION=4.4.2
LABEL org.opencontainers.image.title="pn-llm-verif engine tapaal (verifypn)" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.source="https://github.com/TAPAAL/verifypn"

COPY engines/common/requirements.txt /tmp/requirements.txt
# hadolint ignore=DL3008
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgmp10 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --no-create-home runner \
 && pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt \
 && rm /tmp/requirements.txt

COPY --from=build /opt/tool /opt/tool
# The adapter kit and the models of the contract: the only code shared with the platform.
COPY api/app/__init__.py /opt/pnverif/app/__init__.py
COPY api/app/domain /opt/pnverif/app/domain
COPY engines/common/pnverif_engine /opt/pnverif/pnverif_engine
COPY engines/tapaal/adapter.py /opt/adapter/adapter.py

ENV PYTHONPATH=/opt/pnverif PYTHONDONTWRITEBYTECODE=1 TOOL_VERSION=${TOOL_VERSION}
USER 10001
ENTRYPOINT ["python", "/opt/adapter/adapter.py"]
