{
  "$defs": {
    "NetSummary": {
      "description": "What the API says about a stored net. Names are reached through inspection, not here.",
      "properties": {
        "arcs": {
          "title": "Arcs",
          "type": "integer"
        },
        "behaviour_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Behaviour Id"
        },
        "initial_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initial Tokens"
        },
        "kind": {
          "enum": [
            "pt",
            "symmetric",
            "hlpn",
            "core",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "net_id": {
          "title": "Net Id",
          "type": "string"
        },
        "pages": {
          "title": "Pages",
          "type": "integer"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "places": {
          "title": "Places",
          "type": "integer"
        },
        "reductions_applied": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reductions Applied",
          "type": "array"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "transitions": {
          "title": "Transitions",
          "type": "integer"
        }
      },
      "required": [
        "net_id",
        "source_id",
        "kind",
        "pages",
        "places",
        "transitions",
        "arcs"
      ],
      "title": "NetSummary",
      "type": "object"
    }
  },
  "description": "Answer to ``POST /v1/nets``: the id, whether the net is new, and its summary.",
  "properties": {
    "created": {
      "title": "Created",
      "type": "boolean"
    },
    "net_id": {
      "title": "Net Id",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/NetSummary"
    }
  },
  "required": [
    "net_id",
    "created",
    "summary"
  ],
  "title": "NetRegistration",
  "type": "object"
}
