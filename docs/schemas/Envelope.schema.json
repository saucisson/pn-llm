{
  "$defs": {
    "ErrorInfo": {
      "description": "Expected failure of a tool (timeout, out of memory, ...), reported in the envelope.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "Page": {
      "description": "Says how much of a list was returned, how much exists, and how to get the rest.",
      "properties": {
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        },
        "returned": {
          "minimum": 0,
          "title": "Returned",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "returned",
        "total"
      ],
      "title": "Page",
      "type": "object"
    },
    "ToolInfo": {
      "description": "The tool and pinned version that produced a result.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ToolInfo",
      "type": "object"
    }
  },
  "description": "Result of every analysis, inspection, reduction and check, around its own ``data``.",
  "properties": {
    "data": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data"
    },
    "elapsed_s": {
      "minimum": 0,
      "title": "Elapsed S",
      "type": "number"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "net_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Net Id"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "tool": {
      "$ref": "#/$defs/ToolInfo"
    },
    "truncated": {
      "anyOf": [
        {
          "$ref": "#/$defs/Page"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "tool",
    "status",
    "elapsed_s"
  ],
  "title": "Envelope",
  "type": "object"
}
