        "job_id",
        "formula_ids"
      ],
      "title": "CheckSubmitted",
      "type": "object"
    },
    "Compare": {
      "description": "Cardinality atom on general terms, such as ``p1 + p2 <= p3``.",
      "properties": {
        "cmp": {
          "enum": [
            "<",
            "<=",
            "==",
            "!=",
            ">=",
            ">"
          ],
          "title": "Cmp",
          "type": "string"
        },
        "left": {
          "discriminator": {
            "mapping": {
              "const": "#/$defs/Constant",
              "tokens": "#/$defs/TokenCount"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TokenCount"
            },
            {
              "$ref": "#/$defs/Constant"
            }
          ],
          "title": "Left"
        },
        "op": {
          "const": "compare",
          "default": "compare",
          "title": "Op",
          "type": "string"
        },
        "right": {
          "discriminator": {
            "mapping": {
              "const": "#/$defs/Constant",
              "tokens": "#/$defs/TokenCount"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TokenCount"
            },
            {
              "$ref": "#/$defs/Constant"
            }
          ],
          "title": "Right"
        }
      },
      "required": [
        "left",
        "cmp",
        "right"
      ],
      "title": "Compare",
      "type": "object"
    },
    "Constant": {
      "description": "A term: a non-negative integer.",
