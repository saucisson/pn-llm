          "items": {
            "discriminator": {
              "mapping": {
                "AF": "#/$defs/CtlUnary",
                "AG": "#/$defs/CtlUnary",
                "AU": "#/$defs/CtlUntil",
                "AX": "#/$defs/CtlUnary",
                "EF": "#/$defs/CtlUnary",
                "EG": "#/$defs/CtlUnary",
                "EU": "#/$defs/CtlUntil",
                "EX": "#/$defs/CtlUnary",
                "F": "#/$defs/LtlUnary",
                "G": "#/$defs/LtlUnary",
                "U": "#/$defs/LtlUntil",
                "X": "#/$defs/LtlUnary",
                "and": "#/$defs/And",
                "compare": "#/$defs/Compare",
                "const": "#/$defs/Truth",
                "deadlock": "#/$defs/Deadlock",
                "enabled": "#/$defs/Enabled",
                "implies": "#/$defs/Implies",
                "not": "#/$defs/Not",
                "or": "#/$defs/Or",
                "tokens": "#/$defs/Tokens"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Tokens"
              },
              {
                "$ref": "#/$defs/Compare"
              },
              {
                "$ref": "#/$defs/Enabled"
              },
              {
                "$ref": "#/$defs/Deadlock"
              },
              {
                "$ref": "#/$defs/Truth"
              },
              {
                "$ref": "#/$defs/Not"
              },
              {
                "$ref": "#/$defs/And"
              },
              {
                "$ref": "#/$defs/Or"
              },
              {
                "$ref": "#/$defs/Implies"
              },
              {
                "$ref": "#/$defs/LtlUnary"
              },
              {
                "$ref": "#/$defs/LtlUntil"
              },
              {
                "$ref": "#/$defs/CtlUnary"
              },
              {
                "$ref": "#/$defs/CtlUntil"
              }
            ]
          },
          "minItems": 2,
          "title": "Args",
          "type": "array"
        },
        "op": {
          "const": "and",
          "default": "and",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "args"
      ],
      "title": "And",
      "type": "object"
    },
    "Answer": {
      "description": "The answer of the user to an open question.",
      "properties": {
        "kind": {
          "const": "answer",
          "default": "answer",
          "title": "Kind",
          "type": "string"
        },
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "text"
      ],
      "title": "Answer",
      "type": "object"
    },
    "AssistantMessage": {
      "description": "Text written by the LLM. It is labelled as such: never a verdict, never a fact of the net.",
