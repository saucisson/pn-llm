{
  "name": "pn-llm-verif",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.14" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "make setup && (cd ui && npm ci)",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "biomejs.biome"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/api/.venv/bin/python",
        "editor.formatOnSave": true
      }
    }
  },
  "forwardPorts": [8000, 5173]
}
