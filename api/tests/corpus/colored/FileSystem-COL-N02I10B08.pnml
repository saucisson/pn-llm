                                    </subterm>
                                    <subterm>
                                        <useroperator declaration="T" />
                                    </subterm>
                                </tuple>
                            </subterm>
                        </numberof>
                    </structure>
                </hlinscription>
            </arc>

            <arc id="ifbusy2busy" source="ifbusy" target="busy">
                <name>
                    <text>ifbusy2busy</text>
                </name>
                <hlinscription>
                    <text>1'(b,T)</text>
                    <structure>
                        <numberof>
