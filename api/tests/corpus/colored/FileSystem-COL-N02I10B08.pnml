                                    <subterm>
                                        <variable refvariable="i" />
                                    </subterm>
                                    <subterm>
                                        <variable refvariable="b" />
                                    </subterm>
                                </tuple>
                            </subterm>
                        </numberof>
                    </structure>
                </hlinscription>
            </arc>

            <arc id="assignblock2blockassoc" source="assignblock" target="blockassoc">
                <name>
                    <text>assignblock2blockassoc</text>
                </name>
                <hlinscription>
                    <text>1'(i,b)</text>
                    <structure>
