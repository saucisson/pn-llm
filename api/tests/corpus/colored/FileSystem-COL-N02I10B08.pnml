                                <numberconstant value="1">
                                    <positive />
                                </numberconstant>
                            </subterm>
                            <subterm>
                                <tuple>
                                    <subterm>
                                        <variable refvariable="b" />
                                    </subterm>
                                    <subterm>
                                        <useroperator declaration="T" />
                                    </subterm>
                                </tuple>
                            </subterm>
                        </numberof>
