<?xml version="1.0"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
    <net id="FileSystem-COL-N02I10B08"
        type="http://www.pnml.org/version-2009/grammar/symmetricnet">
        <name>
            <text>FileSystem-COL-N02I10B08</text>
        </name>
        <page id="page">

            <!-- %%%%%%%%%%%%%%%%%%%%%%%%%     PLACES     %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% -->

            <place id="idle">
                <name>
                    <text>idle</text>
                </name>
                <type>
                    <text>Dot</text>
                    <structure>
                        <usersort declaration="dot" />
                    </structure>
                </type>
                <hlinitialMarking>
                    <text>N'(dot)</text>
                    <structure>
                        <numberof>
                            <subterm>
                                <numberconstant value="2">
                                    <positive />
                                </numberconstant>
                            </subterm>
                            <subterm>
                                <dotconstant />
                            </subterm>
                        </numberof>
                    </structure>
                </hlinitialMarking>
            </place>

            <place id="inodelist">
                <name>
                    <text>inodelist</text>
                </name>
                <type>
                    <text>INODE</text>
                    <structure>
                        <usersort declaration="INODE" />
                    </structure>
                </type>
                <hlinitialMarking>
                    <text>1'(INODE.all)</text>
                    <structure>
                        <numberof>
                            <subterm>
                                <numberconstant value="1">
                                    <positive />
                                </numberconstant>
                            </subterm>
                            <subterm>
                                <all>
                                    <usersort declaration="INODE" />
                                </all>
                            </subterm>
                        </numberof>
                    </structure>
                </hlinitialMarking>
            </place>

            <place id="initblock">
                <name>
                    <text>initblock</text>
                </name>
                <type>
                    <text>INODE</text>
                    <structure>
                        <usersort declaration="INODE" />
                    </structure>
                </type>
            </place>

            <place id="inode">
                <name>
                    <text>inode</text>
                </name>
                <type>
                    <text>PAIR</text>
                    <structure>
                        <usersort declaration="PAIR" />
                    </structure>
                </type>
            </place>

            <place id="blockassoc">
                <name>
                    <text>blockassoc</text>
                </name>
                <type>
                    <text>PAIR</text>
                    <structure>
                        <usersort declaration="PAIR" />
                    </structure>
                </type>
                <hlinitialMarking>
                    <text>1'(i, 2*i % B) | i in 1..I</text>
                    <structure>
                        <add>  <subterm>
                                <numberof>
                                    <subterm>
                                        <numberconstant value="1">
                                            <positive />
                                        </numberconstant>
                                    </subterm>
                                    <subterm>
                                        <tuple>
                                            <subterm>
                                                <useroperator declaration="i0" />
                                            </subterm>
                                            <subterm>
                                                <useroperator declaration="b0" />
                                            </subterm>
                                        </tuple>
                                    </subterm>
                                </numberof>
                            </subterm>
                             <subterm>
                                <numberof>
                                    <subterm>
                                        <numberconstant value="1">
                                            <positive />
                                        </numberconstant>
                                    </subterm>
                                    <subterm>
                                        <tuple>
                                            <subterm>
                                                <useroperator declaration="i1" />
                                            </subterm>
                                            <subterm>
                                                <useroperator declaration="b2" />
                                            </subterm>
                                        </tuple>
                                    </subterm>
                                </numberof>
                            </subterm>
                             <subterm>
                                <numberof>
                                    <subterm>
                                        <numberconstant value="1">
                                            <positive />
                                        </numberconstant>
                                    </subterm>
                                    <subterm>
                                        <tuple>
                                            <subterm>
                                                <useroperator declaration="i2" />
                                            </subterm>
                                            <subterm>
                                                <useroperator declaration="b4" />
                                            </subterm>
                                        </tuple>
                                    </subterm>
                                </numberof>
                            </subterm>
                             <subterm>
                                <numberof>
                                    <subterm>
                                        <numberconstant value="1">
                                            <positive />
                                        </numberconstant>
                                    </subterm>
                                    <subterm>
                                        <tuple>
                                            <subterm>
                                                <useroperator declaration="i3" />
                                            </subterm>
                                            <subterm>
                                                <useroperator declaration="b6" />
                                            </subterm>
                                        </tuple>
                                    </subterm>
                                </numberof>
                            </subterm>
                             <subterm>
                                <numberof>
                                    <subterm>
                                        <numberconstant value="1">
                                            <positive />
                                        </numberconstant>
                                    </subterm>
                                    <subterm>
                                        <tuple>
                                            <subterm>
                                                <useroperator declaration="i4" />
                                            </subterm>
                                            <subterm>
                                                <useroperator declaration="b0" />
                                            </subterm>
                                        </tuple>
                                    </subterm>
                                </numberof>
                            </subterm>
                             <subterm>
                                <numberof>
                                    <subterm>
                                        <numberconstant value="1">
                                            <positive />
                                        </numberconstant>
                                    </subterm>
                                    <subterm>
                                        <tuple>
                                            <subterm>
                                                <useroperator declaration="i5" />
                                            </subterm>
                                            <subterm>
                                                <useroperator declaration="b2" />
                                            </subterm>
                                        </tuple>
                                    </subterm>
                                </numberof>
                            </subterm>
                             <subterm>
                                <numberof>
                                    <subterm>
                                        <numberconstant value="1">
                                            <positive />
                                        </numberconstant>
                                    </subterm>
                                    <subterm>
                                        <tuple>
                                            <subterm>
                                                <useroperator declaration="i6" />
                                            </subterm>
                                            <subterm>
                                                <useroperator declaration="b4" />
                                            </subterm>
                                        </tuple>
                                    </subterm>
                                </numberof>
                            </subterm>
                             <subterm>
                                <numberof>
                                    <subterm>
                                        <numberconstant value="1">
                                            <positive />
                                        </numberconstant>
                                    </subterm>
                                    <subterm>
                                        <tuple>
                                            <subterm>
                                                <useroperator declaration="i7" />
                                            </subterm>
                                            <subterm>
                                                <useroperator declaration="b6" />
                                            </subterm>
                                        </tuple>
                                    </subterm>
                                </numberof>
                            </subterm>
                             <subterm>
                                <numberof>
                                    <subterm>
                                        <numberconstant value="1">
                                            <positive />
                                        </numberconstant>
                                    </subterm>
                                    <subterm>
                                        <tuple>
                                            <subterm>
                                                <useroperator declaration="i8" />
                                            </subterm>
                                            <subterm>
                                                <useroperator declaration="b0" />
                                            </subterm>
                                        </tuple>
                                    </subterm>
                                </numberof>
                            </subterm>
                             <subterm>
                                <numberof>
                                    <subterm>
                                        <numberconstant value="1">
                                            <positive />
                                        </numberconstant>
                                    </subterm>
                                    <subterm>
                                        <tuple>
                                            <subterm>
                                                <useroperator declaration="i9" />
                                            </subterm>
                                            <subterm>
                                                <useroperator declaration="b2" />
                                            </subterm>
                                        </tuple>
                                    </subterm>
                                </numberof>
                            </subterm>
                             </add>
                    </structure>
                </hlinitialMarking>
            </place>

            <place id="beginloop">
