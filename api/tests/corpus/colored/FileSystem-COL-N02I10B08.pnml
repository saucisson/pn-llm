            <place id="busy">
                <name>
                    <text>busy</text>
                </name>
                <type>
                    <text>BUSY</text>
                    <structure>
                        <usersort declaration="BUSY" />
                    </structure>
                </type>
                <hlinitialMarking>
                    <text>1'(b1,F) + 1'(b2,F) + ... + 1'(bB,F)</text>
                    <structure>
                        <add>  <subterm>
                                <numberof>
                                    <subterm>
                                        <numberconstant value="1">
                                            <positive />
                                        </numberconstant>
                                    </subterm>
                                    <subterm>
                                        <tuple>
                                            <subterm>
                                                <useroperator declaration="b0" />
                                            </subterm>
                                            <subterm>
                                                <useroperator declaration="F" />
                                            </subterm>
                                        </tuple>
                                    </subterm>
                                </numberof>
                            </subterm>
                             <subterm>
                                <numberof>
                                    <subterm>
                                        <numberconstant value="1">
                                            <positive />
                                        </numberconstant>
                                    </subterm>
                                    <subterm>
                                        <tuple>
                                            <subterm>
                                                <useroperator declaration="b1" />
                                            </subterm>
                                            <subterm>
                                                <useroperator declaration="F" />
                                            </subterm>
                                        </tuple>
                                    </subterm>
                                </numberof>
                            </subterm>
                             <subterm>
                                <numberof>
                                    <subterm>
                                        <numberconstant value="1">
                                            <positive />
                                        </numberconstant>
                                    </subterm>
                                    <subterm>
                                        <tuple>
                                            <subterm>
                                                <useroperator declaration="b2" />
                                            </subterm>
                                            <subterm>
                                                <useroperator declaration="F" />
                                            </subterm>
                                        </tuple>
                                    </subterm>
                                </numberof>
                            </subterm>
                             <subterm>
                                <numberof>
                                    <subterm>
                                        <numberconstant value="1">
                                            <positive />
                                        </numberconstant>
                                    </subterm>
                                    <subterm>
                                        <tuple>
                                            <subterm>
                                                <useroperator declaration="b3" />
                                            </subterm>
                                            <subterm>
                                                <useroperator declaration="F" />
                                            </subterm>
                                        </tuple>
                                    </subterm>
                                </numberof>
                            </subterm>
                             <subterm>
                                <numberof>
                                    <subterm>
                                        <numberconstant value="1">
                                            <positive />
                                        </numberconstant>
                                    </subterm>
                                    <subterm>
                                        <tuple>
                                            <subterm>
                                                <useroperator declaration="b4" />
                                            </subterm>
                                            <subterm>
                                                <useroperator declaration="F" />
                                            </subterm>
                                        </tuple>
                                    </subterm>
                                </numberof>
                            </subterm>
                             <subterm>
                                <numberof>
                                    <subterm>
                                        <numberconstant value="1">
                                            <positive />
