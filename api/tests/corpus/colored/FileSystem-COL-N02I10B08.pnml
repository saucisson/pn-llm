            <arc id="busy2ifnotbusy" source="busy" target="ifnotbusy">
                <name>
                    <text>busy2ifnotbusy</text>
                </name>
                <hlinscription>
                    <text>1'(b,F)</text>
                    <structure>
                        <numberof>
                            <subterm>
                                <numberconstant value="1">
                                    <positive />
                                </numberconstant>
                            </subterm>
                            <subterm>
                                <tuple>
                                    <subterm>
                                        <variable refvariable="b" />
                                    </subterm>
                                    <subterm>
                                        <useroperator declaration="F" />
                                    </subterm>
                                </tuple>
                            </subterm>
                        </numberof>
                    </structure>
                </hlinscription>
            </arc>

            <arc id="ifnotbusy2busy" source="ifnotbusy" target="busy">
                <name>
