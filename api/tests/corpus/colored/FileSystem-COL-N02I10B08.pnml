            </arc>

            <arc id="ifbusy2loop" source="ifbusy" target="loop">
                <name>
                    <text>ifbusy2loop</text>
                </name>
                <hlinscription>
                    <text>1'(i,b)</text>
                    <structure>
                        <numberof>
                            <subterm>
                                <numberconstant value="1">
                                    <positive />
                                </numberconstant>
                            </subterm>
                            <subterm>
                                <tuple>
                                    <subterm>
                                        <variable refvariable="i" />
                                    </subterm>
                                    <subterm>
                                        <variable refvariable="b" />
                                    </subterm>
                                </tuple>
                            </subterm>
                        </numberof>
                    </structure>
                </hlinscription>
            </arc>

            <!-- %%%%%%%%%%%%%%%%%%%%%%%%%   TRANSITION incrementb %%%%%%%%%%%%%%%%%%%%%%% -->

            <transition id="incrementb">
                <name>
                    <text>incrementb</text>
                </name>
            </transition>

            <arc id="incrementb2beginloop" source="incrementb" target="beginloop">
                <name>
                    <text>incrementb2beginloop</text>
                </name>
                <hlinscription>
                    <text>1'(i,b++)</text>
                    <structure>
                        <numberof>
                            <subterm>
                                <numberconstant value="1">
                                    <positive />
                                </numberconstant>
                            </subterm>
                            <subterm>
                                <tuple>
                                    <subterm>
                                        <variable refvariable="i" />
                                    </subterm>
                                    <subterm>
                                        <successor>
                                            <subterm>
                                                <variable refvariable="b" />
                                            </subterm>
                                        </successor>
                                    </subterm>
                                </tuple>
                            </subterm>
                        </numberof>
                    </structure>
                </hlinscription>
            </arc>

            <arc id="loop2incrementb" source="loop" target="incrementb">
                <name>
                    <text>loop2</text>
                </name>
                <hlinscription>
                    <text>1'(i,b)</text>
                    <structure>
