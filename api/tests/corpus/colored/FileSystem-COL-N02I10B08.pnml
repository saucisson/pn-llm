            <!-- %%%%%%%%%%%%%%%%%%%%%%%%%%% DECLARATIONS %%%%%%%%%%%%%%%%%%%%%%%%%%%%%% -->

        </page>

        <declaration>
            <structure>
                <declarations>
                    <namedsort id="dot" name="Dot">
                        <dot />
                    </namedsort>
                    <namedsort id="INODE" name="INODE">
                        <cyclicenumeration> <feconstant id="i0" name="i0" /> <feconstant id="i1" name="i1" /> <feconstant id="i2" name="i2" /> <feconstant id="i3" name="i3" /> <feconstant id="i4" name="i4" /> <feconstant id="i5" name="i5" /> <feconstant id="i6" name="i6" /> <feconstant id="i7" name="i7" /> <feconstant id="i8" name="i8" /> <feconstant id="i9" name="i9" /> </cyclicenumeration>
                    </namedsort>
                    <namedsort id="BLOCK" name="BLOCK">
                        <cyclicenumeration> <feconstant id="b0" name="b0" /> <feconstant id="b1" name="b1" /> <feconstant id="b2" name="b2" /> <feconstant id="b3" name="b3" /> <feconstant id="b4" name="b4" /> <feconstant id="b5" name="b5" /> <feconstant id="b6" name="b6" /> <feconstant id="b7" name="b7" /> </cyclicenumeration>
                    </namedsort>
                    <namedsort id="Bool" name="Bool">
                        <cyclicenumeration>
                            <feconstant id="T" name="T" />
                            <feconstant id="F" name="F" />
                        </cyclicenumeration>
                    </namedsort>
                    <namedsort id="BUSY" name="BUSY">
                        <productsort>
                            <usersort declaration="BLOCK" />
                            <usersort declaration="Bool" />
                        </productsort>
                    </namedsort>
                    <namedsort id="PAIR" name="PAIR">
                        <productsort>
                            <usersort declaration="INODE" />
                            <usersort declaration="BLOCK" />
                        </productsort>
                    </namedsort>
                    <variabledecl id="i" name="i">
                        <usersort declaration="INODE" />
                    </variabledecl>
                    <variabledecl id="b" name="b">
                        <usersort declaration="BLOCK" />
                    </variabledecl>
                </declarations>
            </structure>
        </declaration>
    </net>
</pnml>
