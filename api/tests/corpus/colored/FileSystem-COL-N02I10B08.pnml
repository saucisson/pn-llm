            </arc>

            <arc id="setinode2lockb" source="setinode" target="lockb">
                <name>
                    <text>setinode2lockb</text>
                </name>
                <hlinscription>
                    <text>1'(b)</text>
                    <structure>
                        <numberof>
                            <subterm>
                                <numberconstant value="1">
                                    <positive />
                                </numberconstant>
                            </subterm>
                            <subterm>
                                <variable refvariable="b" />
                            </subterm>
                        </numberof>
                    </structure>
                </hlinscription>
            </arc>

            <arc id="setinode2inode" source="setinode" target="inode">
                <name>
                    <text>setinode2inode</text>
                </name>
                <hlinscription>
                    <text>1'(i,b)</text>
                    <structure>
                        <numberof>
                            <subterm>
                                <numberconstant value="1">
                                    <positive />
                                </numberconstant>
                            </subterm>
                            <subterm>
                                <tuple>
                                    <subterm>
                                        <variable refvariable="i" />
                                    </subterm>
                                    <subterm>
                                        <variable refvariable="b" />
                                    </subterm>
                                </tuple>
                            </subterm>
                        </numberof>
                    </structure>
                </hlinscription>
            </arc>

            <arc id="setinode2idle" source="setinode" target="idle">
                <name>
                    <text>setinode2idle</text>
                </name>
                <hlinscription>
                    <text>1'(dot)</text>
                    <structure>
                        <numberof>
