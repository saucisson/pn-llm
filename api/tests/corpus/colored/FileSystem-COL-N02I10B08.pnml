            <arc id="incrementb2lockb" source="incrementb" target="lockb">
                <name>
                    <text>incrementb2lockb</text>
                </name>
                <hlinscription>
                    <text>1'(b)</text>
                    <structure>
                        <numberof>
                            <subterm>
                                <numberconstant value="1">
                                    <positive />
                                </numberconstant>
                            </subterm>
                            <subterm>
                                <subterm>
                                    <variable refvariable="b" />
                                </subterm>
                            </subterm>
                        </numberof>
                    </structure>
                </hlinscription>
            </arc>

            <!-- %%%%%%%%%%%%%%%%%%%%%%%%%   TRANSITION setinode %%%%%%%%%%%%%%%%%%%%%%% -->

            <transition id="setinode">
                <name>
                    <text>setinode</text>
                </name>
            </transition>

            <arc id="endloop2setinode" source="endloop" target="setinode">
                <name>
                    <text>endloop2setinode</text>
                </name>
                <hlinscription>
                    <text>1'(i,b)</text>
                    <structure>
