            <!-- %%%%%%%%%%%%%%%%%%%%%%%%%   TRANSITION choosei %%%%%%%%%%%%%%%%%%%%%%% -->

            <transition id="choosei">
                <name>
                    <text>choosei</text>
                </name>
            </transition>

            <arc id="idle2choosei" source="idle" target="choosei">
                <name>
                    <text>idle2choosei</text>
                </name>
                <hlinscription>
                    <text>1'(t)</text>
                    <structure>
                        <numberof>
                            <subterm>
                                <numberconstant value="1">
                                    <positive />
                                </numberconstant>
                            </subterm>
                            <subterm>
                                <dotconstant />
                            </subterm>
                        </numberof>
                    </structure>
                </hlinscription>
            </arc>

            <arc id="inodelist2choosei" source="inodelist" target="choosei">
                <name>
                    <text>inodelist2choosei</text>
                </name>
                <hlinscription>
                    <text>1'(i)</text>
                    <structure>
                        <numberof>
                            <subterm>
                                <numberconstant value="1">
                                    <positive />
                                </numberconstant>
                            </subterm>
                            <subterm>
                                <variable refvariable="i" />
                            </subterm>
                        </numberof>
                    </structure>
                </hlinscription>
            </arc>

            <arc id="choosei2initblock" source="choosei" target="initblock">
                <name>
                    <text>choosei2initblock</text>
                </name>
                <hlinscription>
                    <text>1'(i)</text>
                    <structure>
                        <numberof>
                            <subterm>
                                <numberconstant value="1">
                                    <positive />
                                </numberconstant>
                            </subterm>
                            <subterm>
                                <variable refvariable="i" />
                            </subterm>
                        </numberof>
                    </structure>
                </hlinscription>
            </arc>


            <!-- %%%%%%%%%%%%%%%%%%%%%%%%%   TRANSITION assignblock %%%%%%%%%%%%%%%%%%%%%%% -->

            <transition id="assignblock">
                <name>
                    <text>assignblock</text>
                </name>
            </transition>

            <arc id="initblock2assignblock" source="initblock" target="assignblock">
                <name>
                    <text>initblock2assignblock</text>
                </name>
                <hlinscription>
                    <text>1'(i)</text>
                    <structure>
                        <numberof>
                            <subterm>
                                <numberconstant value="1">
                                    <positive />
                                </numberconstant>
                            </subterm>
                            <subterm>
