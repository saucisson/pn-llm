                            </subterm>
                            <subterm>
                                <tuple>
                                    <subterm>
                                        <variable refvariable="i" />
                                    </subterm>
                                    <subterm>
                                        <variable refvariable="b" />
                                    </subterm>
                                </tuple>
                            </subterm>
                        </numberof>
                    </structure>
                </hlinscription>
            </arc>

            <arc id="assignblock2beginloop" source="assignblock" target="beginloop">
                <name>
                    <text>assignblock2beginloop</text>
                </name>
                <hlinscription>
                    <text>1'(i,b)</text>
                    <structure>
                        <numberof>
