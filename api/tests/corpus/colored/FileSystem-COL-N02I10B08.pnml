            <!-- %%%%%%%%%%%%%%%%%%%%%%%%%   TRANSITION ifnotbusy %%%%%%%%%%%%%%%%%%%%%%% -->

            <transition id="ifnotbusy">
                <name>
                    <text>ifnotbusy</text>
                </name>
            </transition>

            <arc id="testbusy2ifnotbusy" source="testbusy" target="ifnotbusy">
                <name>
                    <text>testbusy2ifnotbusy</text>
                </name>
                <hlinscription>
                    <text>1'(i,b)</text>
                    <structure>
                        <numberof>
                            <subterm>
                                <numberconstant value="1">
                                    <positive />
                                </numberconstant>
                            </subterm>
                            <subterm>
                                <tuple>
                                    <subterm>
                                        <variable refvariable="i" />
                                    </subterm>
                                    <subterm>
                                        <variable refvariable="b" />
                                    </subterm>
