                            </subterm>
                            <subterm>
                                <tuple>
                                    <subterm>
                                        <variable refvariable="i" />
                                    </subterm>
                                    <subterm>
                                        <variable refvariable="b" />
                                    </subterm>
                                </tuple>
                            </subterm>
                        </numberof>
                    </structure>
                </hlinscription>
            </arc>

            <!-- %%%%%%%%%%%%%%%%%%%%%%%%%   TRANSITION acquirelock %%%%%%%%%%%%%%%%%%%%%%% -->

            <transition id="acquirelock">
                <name>
                    <text>acquirelock</text>
